# --- Banco de dados (Postgres próprio: Neon, Supabase, VPS...) ---
# Neon: DATABASE_URL = URL "pooled" (-pooler); DIRECT_URL = URL direta (usada em migrações).
DATABASE_URL=postgresql://unha:local-development-only@127.0.0.1:54330/unha
DIRECT_URL=postgresql://unha:local-development-only@127.0.0.1:54330/unha

# --- Segurança ---
# Segredo do cron de lembretes (Vercel envia como Bearer). Gere: openssl rand -hex 32
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Origem exata do app (CSRF). Ex.: https://agenda.seudominio.com
APP_ORIGIN=http://localhost:3000

# --- Primeiro administrador (usado por npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# --- WhatsApp (WA-AKG hospedado em VPS/Docker; não roda na Vercel) ---
WA_AKG_URL=http://localhost:3001
WA_AKG_API_KEY=
# Segredo configurado no webhook do WA-AKG (HMAC) -> /api/webhooks/whatsapp
WA_WEBHOOK_SECRET=

