# --- Banco de dados (Postgres próprio: Neon, Supabase, VPS...) ---
# Neon: DATABASE_URL = URL "pooled" (-pooler); DIRECT_URL = URL direta (usada em migrações).
DATABASE_URL=postgresql://unha:local-development-only@127.0.0.1:54330/unha
DIRECT_URL=postgresql://unha:local-development-only@127.0.0.1:54330/unha

# --- Segurança ---
# Segredo do cron de lembretes (Vercel envia como Bearer). Gere: openssl rand -hex 32
CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Origem exata do app (CSRF). Ex.: https://agenda.seudominio.com
APP_ORIGIN=http://localhost:3000

# --- Primeiro administrador (usado por npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# --- WhatsApp (WA-AKG hospedado em VPS/Docker; não roda na Vercel) ---
WA_AKG_URL=http://localhost:3001
WA_AKG_API_KEY=
# Segredo configurado no webhook do WA-AKG (HMAC) -> /api/webhooks/whatsapp
WA_WEBHOOK_SECRET=

# --- E-mail (Resend) — link de "Esqueci minha senha" ---
# Opcional. Sem as duas variáveis, o link vai para o WhatsApp do estúdio (ou para o log do servidor).
# Chave "Sending access" criada em resend.com > API Keys. Segredo: nunca commitar.
RESEND_API_KEY=
# Remetente de um domínio VERIFICADO no Resend (DNS: DKIM resend._domainkey + registros do subdomínio send).
# Antes de verificar o domínio, só funciona "onboarding@resend.dev" e apenas para o e-mail da própria conta do Resend.
# Ex.: EMAIL_FROM="Bem-vindo Agenda <nao-responda@bemvindoagenda.com.br>"
EMAIL_FROM=

